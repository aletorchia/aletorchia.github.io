<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MealWise.Mobile.Views.MealCalendarPage"
    x:Name="CalendarPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:MealWise.Mobile.Models"
    xmlns:viewmodels="clr-namespace:MealWise.Mobile.ViewModels"
    x:DataType="viewmodels:MealCalendarViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="16">
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Label Text="Calendario" Style="{StaticResource Headline}" />
            <Label
                Text="Pasti pianificati dalle ricette aggiunte dal dettaglio."
                HorizontalTextAlignment="Center"
                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="10">
            <Button
                Command="{Binding LoadCommand}"
                Text="Aggiorna calendario" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}" />

            <Border
                Padding="12"
                BackgroundColor="{AppThemeBinding Light=#FFFFF2, Dark=#332400}"
                IsVisible="{Binding HasError}"
                Stroke="{AppThemeBinding Light=#F0C36D, Dark=#8A6A1F}">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="{AppThemeBinding Light=#5C4100, Dark=#FFD98A}" />
                    <Button
                        Command="{Binding LoadCommand}"
                        Text="Riprova" />
                </VerticalStackLayout>
            </Border>

            <Label
                IsVisible="{Binding IsEmptyState}"
                Text="Nessun pasto pianificato."
                HorizontalTextAlignment="Center"
                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="2"
            IsVisible="{Binding HasData}"
            ItemsSource="{Binding PlannedMeals}"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PlannedMeal">
                    <Border
                        Margin="0,0,0,12"
                        Padding="12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                        <Grid ColumnDefinitions="84,*" ColumnSpacing="12">
                            <Image
                                Aspect="AspectFill"
                                HeightRequest="84"
                                Source="{Binding ThumbnailUrl}"
                                WidthRequest="84" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="6">
                                <Label
                                    Text="{Binding DateText}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="16" />
                                <Label
                                    Text="{Binding RecipeName}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="18"
                                    LineBreakMode="WordWrap" />
                                <Label
                                    Text="{Binding IngredientSummary}"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
                                <Button
                                    Command="{Binding BindingContext.RemoveMealCommand, Source={x:Reference CalendarPageRoot}}"
                                    CommandParameter="{Binding .}"
                                    Text="Rimuovi" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
