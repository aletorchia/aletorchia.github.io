<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MealWise.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MealWise.Mobile.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="MealWise">

    <TabBar>
        <ShellContent
            Title="Home"
            Route="home"
            ContentTemplate="{DataTemplate views:HomePage}" />

        <ShellContent
            Title="Search"
            Route="search"
            ContentTemplate="{DataTemplate views:SearchPage}" />

        <ShellContent
            Title="Browse"
            Route="browse"
            ContentTemplate="{DataTemplate views:BrowsePage}" />

        <ShellContent
            Title="Calendario"
            Route="calendar"
            ContentTemplate="{DataTemplate views:MealCalendarPage}" />

        <ShellContent
            Title="Spesa"
            Route="shopping"
            ContentTemplate="{DataTemplate views:ShoppingListPage}" />
    </TabBar>

</Shell>
